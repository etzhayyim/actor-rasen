(require '[kotoba.lang.edn :as edn] '[kotoba.io :as io] '[kotoba.lang.text :as str]
         '[kotoba.test :as t])
(def c (edn/read-string (slurp "repository-contracts.edn")))
(doseq [p (:required c)] (assert (io/file? (io/file p)) (str "missing " p)))
(doseq [f (io/file-seq (io/file ".")) :when (and (io/file? f) (str/ends-with? (io/file-name f) ".edn")
                                               (not (str/includes? (io/path f) "/.git/")))]
  (edn/read-string (slurp f)))
(let [bad (for [f (io/file-seq (io/file ".")) :when (and (io/file? f)
                 (not (str/includes? (io/path f) "/.git/"))
                 (some #(str/ends-with? (io/file-name f) %) (:forbidden-extensions c)))] f)]
  (assert (empty? bad) (str "forbidden " bad)))
(def nss '[rasen.murakumo-test rasen.methods.test-cid rasen.methods.test-gene-node
           rasen.tests.test-analyze rasen.tests.test-coverage rasen.tests.test-datom-emit
           rasen.tests.test-ingest rasen.tests.test-wasm rasen.tests.test-kotoba
           rasen.tests.test-publish rasen.tests.test-clinvar rasen.tests.test-ledger-shards rasen.tests.test-clinvar-run rasen.tests.test-kotobase-publish rasen.tests.test-gnomad rasen.tests.test-shard-archive])
(doseq [n nss] (require n))
(let [r (apply t/run-tests nss)] (System/exit (if (zero? (+ (:fail r) (:error r))) 0 1)))
